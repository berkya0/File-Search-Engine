<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.FlowPane?>
<ScrollPane fitToWidth="true" style="-fx-background-color: #F8FAFC; -fx-background-insets: 0; -fx-padding: 0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berkaykomur.filesearchfrontend.view.DashboardView">
    <content>
        <VBox spacing="25.0" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Genel Bakış" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Hızlı erişim, sık kullanılan veriler ve favori dizinleriniz." textFill="#64748B">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox maxWidth="800.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="⭐ Favori Klasörler" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <FlowPane fx:id="favFoldersContainer" hgap="15.0" vgap="15.0">
                            <children>
                                <VBox prefWidth="230.0" spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 14;">
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="📁 Projeler" textFill="#1E293B">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                        <Label text="C:/Users/berkay/Projects" textFill="#64748B" wrapText="true">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                        <Button maxWidth="Infinity" style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6;" text="Burada Ara" />
                                    </children>
                                </VBox>

                                <VBox prefWidth="230.0" spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 14;">
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="📁 İndirilenler" textFill="#1E293B">
                                            <font><Font size="13.0" /></font>
                                        </Label>
                                        <Label text="C:/Users/berkay/Downloads" textFill="#64748B" wrapText="true">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                        <Button maxWidth="Infinity" style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 6;" text="Burada Ara" />
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER" prefHeight="105.0" prefWidth="140.0" style="-fx-border-color: #CBD5E1; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 12;">
                                    <children>
                                        <Label text="➕" textFill="#94A3B8">
                                            <font><Font size="20.0" /></font>
                                        </Label>
                                        <Label text="Yeni Ekle" textFill="#64748B">
                                            <font><Font size="12.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </FlowPane>
                    </children>
                </VBox>

                <VBox maxWidth="800.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label prefHeight="22.0" prefWidth="293.0" text="🔥 Son Kullanılan Dosyalar ve Klasörler" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <ListView fx:id="frequentSearchesListView" prefHeight="180.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-border-color: transparent;" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
